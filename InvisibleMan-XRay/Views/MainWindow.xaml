<ui:FluentWindow x:Class="InvisibleManXRay.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:InvisibleManXRay.Views.Pages"
                 mc:Ignorable="d"
                 Title="Invisible Man XRay"
                 Width="1200"
                 Height="780"
                 MinWidth="960"
                 MinHeight="660"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource SegoeUI}"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid>
        <ui:NavigationView x:Name="RootNavigation"
                           TitleBar="{Binding ElementName=AppTitleBar}"
                           PaneDisplayMode="Left"
                           OpenPaneLength="226"
                           CompactPaneLength="56"
                           IsPaneToggleVisible="True"
                           IsBackButtonVisible="Collapsed"
                           AlwaysShowHeader="False"
                           FrameMargin="0"
                           TransitionDuration="250"
                           Background="Transparent"
                           Navigated="OnNavigationNavigated">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="ProfileNavigationItem"
                                       Content="{DynamicResource Lang.Navigation.Profile}"
                                       TargetPageType="{x:Type pages:ProfilePage}"
                                       Icon="{ui:SymbolIcon Person24}"/>
                <ui:NavigationViewItem x:Name="ServersNavigationItem"
                                       Content="{DynamicResource Lang.Navigation.Servers}"
                                       TargetPageType="{x:Type pages:ServersPage}"
                                       Icon="{ui:SymbolIcon Server24}"/>
                <ui:NavigationViewItem x:Name="SettingsNavigationItem"
                                       Content="{DynamicResource Lang.Navigation.Settings}"
                                       TargetPageType="{x:Type pages:SettingsPage}"
                                       Icon="{ui:SymbolIcon Settings24}"/>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter"/>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:TitleBar x:Name="AppTitleBar"
                     Title="Invisible Man XRay"
                     CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="ShieldCheckmark24"
                               Foreground="{DynamicResource Accent.Success.Brush}"/>
            </ui:TitleBar.Icon>

            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <ui:Button Style="{StaticResource Button.Icon.Ghost}"
                               ToolTip="{DynamicResource Lang.ToolTip.SourceCodeOnGitHub}"
                               Click="OnGitHubButtonClick">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Code24" FontSize="14"/>
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Style="{StaticResource Button.Icon.Ghost}"
                               ToolTip="{DynamicResource Lang.ToolTip.BugReporting}"
                               Click="OnBugReportingButtonClick">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Bug24" FontSize="14"/>
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Style="{StaticResource Button.Icon.Ghost}"
                               ToolTip="{DynamicResource Lang.ToolTip.CheckForUpdates}"
                               Click="OnUpdateButtonClick">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14"/>
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Style="{StaticResource Button.Icon.Ghost}"
                               ToolTip="{DynamicResource Lang.ToolTip.About}"
                               Click="OnAboutButtonClick">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Info24" FontSize="14"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Rectangle Panel.ZIndex="10"
                   IsHitTestVisible="False"
                   Fill="{DynamicResource Texture.Noise}"
                   Opacity="0.04"/>
    </Grid>
</ui:FluentWindow>
