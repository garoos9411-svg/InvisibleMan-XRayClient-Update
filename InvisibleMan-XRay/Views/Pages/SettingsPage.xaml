<Page x:Class="InvisibleManXRay.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:InvisibleManXRay.Converters"
      Title="Settings"
      Background="Transparent"
      FontFamily="{StaticResource SegoeUI}">

    <Page.Resources>
        <Style x:Key="SettingsActionButton"
               TargetType="{x:Type ui:Button}"
               BasedOn="{StaticResource Button.Card.Action}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="32,20,32,32">
        <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch">

            <StackPanel Margin="2,4,0,24">
                <TextBlock Style="{StaticResource Text.PageTitle}"
                           Text="{DynamicResource Lang.Settings.Title}"/>
                <TextBlock Style="{StaticResource Text.PageSubtitle}"
                           Margin="0,6,0,0"
                           Text="{DynamicResource Lang.Settings.Subtitle}"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">

                    <Border Style="{StaticResource Surface.Card}" Padding="20">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource Surface.IconTile}">
                                    <ui:SymbolIcon Symbol="WeatherSunny24"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource Accent.Success.Brush}"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="14,0,12,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.CardTitle}"
                                               Text="{DynamicResource Lang.Settings.Appearance}"/>
                                    <TextBlock Style="{StaticResource Text.Overline}"
                                               Margin="0,3,0,0"
                                               Text="{DynamicResource Lang.Settings.Theme}"/>
                                </StackPanel>

                                <!-- Current mode pill: content driven by SettingsViewModel.ThemeMode -->
                                <Border Grid.Column="2"
                                        Style="{StaticResource Surface.Pill}"
                                        Padding="10,5"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal"
                                                    Style="{StaticResource Visible.WhenThemeDark}">
                                            <ui:SymbolIcon Symbol="WeatherMoon24"
                                                           FontSize="12"
                                                           Margin="0,0,6,0"
                                                           Foreground="{DynamicResource Accent.Traffic.Brush}"/>
                                            <TextBlock Text="{DynamicResource Lang.Settings.Theme.Dark}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Style="{StaticResource Visible.WhenThemeLight}">
                                            <ui:SymbolIcon Symbol="WeatherSunny24"
                                                           FontSize="12"
                                                           Margin="0,0,6,0"
                                                           Foreground="{DynamicResource Accent.Success.Brush}"/>
                                            <TextBlock Text="{DynamicResource Lang.Settings.Theme.Light}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Style="{StaticResource Visible.WhenThemeSystem}">
                                            <ui:SymbolIcon Symbol="Desktop24"
                                                           FontSize="12"
                                                           Margin="0,0,6,0"
                                                           Foreground="{DynamicResource Accent.Traffic.Brush}"/>
                                            <TextBlock Text="{DynamicResource Lang.Settings.Theme.System}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBlock Margin="0,16,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                        <Setter Property="Text" Value="{DynamicResource Lang.Settings.Theme.Dark.Description}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThemeMode}" Value="Light">
                                                <Setter Property="Text" Value="{DynamicResource Lang.Settings.Theme.Light.Description}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ThemeMode}" Value="System">
                                                <Setter Property="Text" Value="{DynamicResource Lang.Settings.Theme.Description}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Segmented theme selector (pure MVVM: binds to ThemeMode + commands) -->
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <RadioButton GroupName="AppTheme"
                                             Style="{StaticResource Radio.ThemeCard}"
                                             Margin="0,0,8,0"
                                             IsChecked="{Binding ThemeMode, Mode=OneWay, Converter={conv:EnumToBoolConverter}, ConverterParameter=Dark}"
                                             Command="{Binding SelectDarkThemeCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="13" Margin="0,0,7,0"/>
                                        <TextBlock Text="{DynamicResource Lang.Settings.Theme.Dark}" FontSize="12"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="AppTheme"
                                             Style="{StaticResource Radio.ThemeCard}"
                                             Margin="0,0,8,0"
                                             IsChecked="{Binding ThemeMode, Mode=OneWay, Converter={conv:EnumToBoolConverter}, ConverterParameter=Light}"
                                             Command="{Binding SelectLightThemeCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="13" Margin="0,0,7,0"/>
                                        <TextBlock Text="{DynamicResource Lang.Settings.Theme.Light}" FontSize="12"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="AppTheme"
                                             Style="{StaticResource Radio.ThemeCard}"
                                             IsChecked="{Binding ThemeMode, Mode=OneWay, Converter={conv:EnumToBoolConverter}, ConverterParameter=System}"
                                             Command="{Binding SelectSystemThemeCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Desktop24" FontSize="13" Margin="0,0,7,0"/>
                                        <TextBlock Text="{DynamicResource Lang.Settings.Theme.SystemMode}" FontSize="12"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Surface.Card}"
                            Padding="20"
                            Margin="0,20,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource Surface.IconTile}">
                                <ui:SymbolIcon Symbol="LockClosed24"
                                               FontSize="18"
                                               Foreground="{DynamicResource Accent.Traffic.Brush}"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.CardTitle}"
                                           Text="{DynamicResource Lang.Settings.Privacy}"/>
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Margin="0,5,0,0"
                                           Text="{DynamicResource Lang.Settings.Privacy.Description}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Surface.Card}"
                            Padding="20"
                            Margin="0,20,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Surface.IconTile}">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24"
                                               FontSize="18"
                                               Foreground="{DynamicResource Accent.Success.Brush}"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.CardTitle}"
                                           Text="{DynamicResource Lang.Settings.Core}"/>
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Margin="0,5,0,0"
                                           Text="{DynamicResource Lang.Settings.Core.Description}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Border Style="{StaticResource Surface.Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardTitle}"
                                       Text="{DynamicResource Lang.Settings.Application}"/>
                            <TextBlock Style="{StaticResource Text.Overline}"
                                       Margin="0,3,0,14"
                                       Text="Invisible Man XRay"/>

                            <ui:Button Style="{StaticResource SettingsActionButton}"
                                       Margin="0,0,0,8"
                                       Content="{DynamicResource Lang.Settings.Open}"
                                       Click="OnOpenSettingsClick">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="15"/>
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button Style="{StaticResource SettingsActionButton}"
                                       Margin="0,0,0,8"
                                       Content="{DynamicResource Lang.Settings.Updates}"
                                       Click="OnOpenUpdateClick">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15"/>
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button Style="{StaticResource SettingsActionButton}"
                                       Margin="0,0,0,8"
                                       Content="{DynamicResource Lang.Settings.About}"
                                       Click="OnOpenAboutClick">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Info24" FontSize="15"/>
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button Style="{StaticResource SettingsActionButton}"
                                       Margin="0,0,0,8"
                                       Content="{DynamicResource Lang.Settings.GitHub}"
                                       Click="OnGitHubClick">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Code24" FontSize="15"/>
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button Style="{StaticResource SettingsActionButton}"
                                       Content="{DynamicResource Lang.Settings.Bug}"
                                       Click="OnBugReportingClick">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Bug24" FontSize="15"/>
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
