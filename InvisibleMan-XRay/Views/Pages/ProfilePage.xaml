<Page x:Class="InvisibleManXRay.Views.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:components="clr-namespace:InvisibleManXRay.Components"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="Profile"
      Background="Transparent"
      FontFamily="{StaticResource SegoeUI}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="{StaticResource Space.Page}">
        <StackPanel MaxWidth="{StaticResource Width.Content.Max}" HorizontalAlignment="Stretch">

            <StackPanel Margin="{StaticResource Space.HeaderBottom}">
                <TextBlock Style="{StaticResource Text.PageTitle}"
                           Text="{DynamicResource Lang.Profile.Title}"/>
                <TextBlock Style="{StaticResource Text.PageSubtitle}"
                           Margin="0,6,0,0"
                           Text="{DynamicResource Lang.Profile.Subtitle}"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource Column.Hero}"/>
                    <ColumnDefinition Width="{StaticResource Column.Equal}"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource Surface.Card}"
                        Margin="0,0,{StaticResource Space.Gutter},0"
                        Padding="{StaticResource Space.Card.Hero}"
                        MinHeight="438"
                        ClipToBounds="True">
                    <Grid>
                        <Border Background="{DynamicResource Accent.Hero.Background}"
                                CornerRadius="{StaticResource Radius.Card}"
                                Margin="{StaticResource Neg.Space.Card.Hero}"
                                IsHitTestVisible="False"/>
                        <Ellipse Width="320" Height="320"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,-170,-100,0"
                                 Fill="{DynamicResource Accent.Hero.Glow}"
                                 IsHitTestVisible="False"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{StaticResource Column.Auto}"/>
                                <RowDefinition Height="{StaticResource Column.Equal}"/>
                                <RowDefinition Height="{StaticResource Column.Auto}"/>
                                <RowDefinition Height="{StaticResource Column.Auto}"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Border Style="{StaticResource Pill.Status}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource Dot.Status}"/>
                                        <TextBlock Style="{StaticResource Text.Status}"/>
                                    </StackPanel>
                                </Border>

                                <ui:Button Style="{StaticResource Button.Icon.Ghost}"
                                           HorizontalAlignment="Right"
                                           ToolTip="{DynamicResource Lang.Navigation.Servers}"
                                           Click="OnManageServersClick">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Server24" FontSize="16"/>
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,18,0,12"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Ellipse Width="252" Height="252"
                                         Fill="{DynamicResource Accent.Hero.Glow}"
                                         Style="{StaticResource Hero.GlowBreathing}"/>
                                <Ellipse Width="216" Height="216"
                                         Fill="{DynamicResource SubtleFillColorSecondaryBrush}"
                                         Stroke="{DynamicResource Accent.Hero.Ring}"
                                         StrokeThickness="1.5"/>
                                <Ellipse Width="178" Height="178"
                                         Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                         Stroke="{DynamicResource CardStrokeColorDefaultBrush}"
                                         StrokeThickness="1"/>
                                <ui:SymbolIcon Symbol="ShieldCheckmark24"
                                               FontSize="54"
                                               Foreground="{DynamicResource Accent.Success.Brush}"
                                               Style="{StaticResource Hidden.WhenConnecting}"/>
                                <components:Loading Width="72" Height="72"
                                                    Foreground="{DynamicResource Accent.Traffic.Brush}"
                                                    Style="{StaticResource Visible.WhenConnecting}"/>
                            </Grid>

                            <TextBlock Grid.Row="2"
                                       Style="{StaticResource Text.Caption}"
                                       TextAlignment="Center"
                                       MaxWidth="380"
                                       HorizontalAlignment="Center"
                                       Text="{DynamicResource Lang.Profile.Status.Description}"/>

                            <ui:Button x:Name="ConnectButton"
                                       Grid.Row="3"
                                       Margin="0,22,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource Button.Hero.Stateful}"/>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">

                    <Border Style="{StaticResource Surface.Card}" Padding="{StaticResource Space.Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource Column.Auto}"/>
                                    <ColumnDefinition Width="{StaticResource Column.Equal}"/>
                                    <ColumnDefinition Width="{StaticResource Column.Auto}"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource Surface.IconTile}">
                                    <ui:SymbolIcon Symbol="Server24"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource Accent.Success.Brush}"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="14,0,12,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.Overline}"
                                               Text="{DynamicResource Lang.Profile.CurrentServer}"/>
                                    <TextBlock x:Name="ServerNameText"
                                               Style="{StaticResource Text.CardTitle}"
                                               Margin="0,4,0,0"
                                               Text="{Binding CurrentServerDisplay}"/>
                                </StackPanel>

                                <ui:Button Grid.Column="2"
                                           Style="{StaticResource Button.Card.Action}"
                                           Height="34"
                                           Padding="14,0"
                                           VerticalAlignment="Center"
                                           Content="{DynamicResource Lang.Profile.Manage}"
                                           Click="OnManageServersClick"/>
                            </Grid>

                            <Border Height="1"
                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    Margin="0,18,0,12"/>

                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Text="{DynamicResource Lang.Profile.ServerHint}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Surface.Card}"
                            Padding="{StaticResource Space.Card}"
                            Margin="{StaticResource Space.SectionTop}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource Text.CardTitle}"
                                           Text="{DynamicResource Lang.Profile.Traffic}"/>
                                <Border Style="{StaticResource Surface.Pill}"
                                        HorizontalAlignment="Right"
                                        Padding="10,4">
                                    <TextBlock Text="KB/s"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource Column.Equal}"/>
                                    <ColumnDefinition Width="{StaticResource Column.Equal}"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            Background="{DynamicResource Accent.Traffic.Soft.Brush}">
                                        <ui:SymbolIcon Symbol="ArrowDownload24"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource Accent.Traffic.Brush}"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Style="{StaticResource Text.Overline}"
                                                   Text="{DynamicResource Lang.Profile.Download}"/>
                                        <TextBlock Style="{StaticResource Text.Metric}"
                                                   FontSize="18"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding Traffic.DownloadSpeed}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Width="32" Height="32"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            Background="{DynamicResource Accent.Success.Soft.Brush}">
                                        <ui:SymbolIcon Symbol="ArrowUpload24"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource Accent.Success.Brush}"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Style="{StaticResource Text.Overline}"
                                                   Text="{DynamicResource Lang.Profile.Upload}"/>
                                        <TextBlock Style="{StaticResource Text.Metric}"
                                                   FontSize="18"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding Traffic.UploadSpeed}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <lvc:CartesianChart Height="78"
                                                Margin="0,16,0,0"
                                                Series="{Binding Traffic.Series}"
                                                XAxes="{Binding Traffic.XAxes}"
                                                YAxes="{Binding Traffic.YAxes}"
                                                LegendPosition="Hidden"
                                                TooltipPosition="Hidden"
                                                AnimationsSpeed="{StaticResource Anim.Transition}"
                                                Style="{StaticResource Visible.WhenTrafficActive}"/>

                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource Hidden.WhenTrafficActive}"
                                       TextWrapping="Wrap"
                                       Text="{DynamicResource Lang.Profile.Traffic.Waiting}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
