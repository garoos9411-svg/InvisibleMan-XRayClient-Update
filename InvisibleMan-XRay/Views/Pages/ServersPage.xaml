<Page x:Class="InvisibleManXRay.Views.Pages.ServersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:components="clr-namespace:InvisibleManXRay.Components"
      Title="Servers"
      Background="Transparent"
      FontFamily="{StaticResource SegoeUI}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <DataTemplate x:Key="ServerCardTemplate">
            <!-- Premium server card: hover glow + lift micro-animation lives in
                 the shared Card.Interactive style (PremiumTheme.xaml) — no magic
                 numbers or inline storyboards here. -->
            <Border Padding="18"
                    Margin="0,0,0,10"
                    Style="{StaticResource Card.Interactive}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="46" Height="46"
                            CornerRadius="{StaticResource Radius.Control}"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{Binding CountryCode}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent.Traffic.Brush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCountry}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ui:SymbolIcon Symbol="Server24"
                                           FontSize="18"
                                           Foreground="{DynamicResource Accent.Traffic.Brush}">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCountry}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="14,0,12,0"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Group}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Overline}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasGroup}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border CornerRadius="9"
                                    Background="{DynamicResource Accent.Success.Soft.Brush}"
                                    Padding="8,3"
                                    Margin="8,0,0,-2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{DynamicResource Lang.Servers.Current}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent.Success.Brush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.CardTitle}"
                                   Margin="0,3,0,0"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <components:Loading Width="16" Height="16"
                                                Foreground="{DynamicResource Accent.Traffic.Brush}"
                                                VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Margin="8,0,4,0"
                                       VerticalAlignment="Center"
                                       Text="{DynamicResource Lang.Servers.Checking}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PingState}" Value="Good">
                                                <Setter Property="Fill" Value="{DynamicResource Accent.Success.Brush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PingState}" Value="Medium">
                                                <Setter Property="Fill" Value="{DynamicResource Accent.Traffic.Brush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PingState}" Value="Bad">
                                                <Setter Property="Fill" Value="{DynamicResource Accent.Danger.Brush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Margin="7,0,4,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding PingText}"/>
                        </StackPanel>

                        <ui:Button Style="{StaticResource Button.Icon.Ghost}"
                                   Command="{Binding TestCommand}"
                                   ToolTip="{DynamicResource Lang.Servers.Refresh}"
                                   Margin="4,0,0,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="32,20,32,32">
        <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch">

            <Grid Margin="2,4,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource Text.PageTitle}"
                               Text="{DynamicResource Lang.Servers.Title}"/>
                    <TextBlock Style="{StaticResource Text.PageSubtitle}"
                               Margin="0,6,0,0"
                               Text="{DynamicResource Lang.Servers.Subtitle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Style="{StaticResource Button.Pill.Secondary}"
                               Height="42"
                               Padding="18,0"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Content="{DynamicResource Lang.Servers.Refresh}"
                               Command="{Binding RefreshCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15"/>
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Style="{StaticResource Button.Pill.Primary}"
                               Height="42"
                               Padding="20,0"
                               VerticalAlignment="Center"
                               Content="{DynamicResource Lang.Servers.Add}"
                               Click="OnOpenServerManagerClick">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" FontSize="15"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <Border Padding="28">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Surface.Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasServers}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="58" Height="58"
                            CornerRadius="{StaticResource Radius.Card}"
                            Background="{DynamicResource Accent.Traffic.Soft.Brush}"
                            BorderBrush="{DynamicResource Accent.Traffic.Border.Brush}"
                            BorderThickness="1">
                        <ui:SymbolIcon Symbol="FolderOpen24"
                                       FontSize="24"
                                       Foreground="{DynamicResource Accent.Traffic.Brush}"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="18,0,24,0"
                                VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Overline}"
                                   Text="{DynamicResource Lang.Servers.Library}"/>
                        <TextBlock Style="{StaticResource Text.CardTitle}"
                                   FontSize="17"
                                   Margin="0,5,0,0"
                                   Text="{DynamicResource Lang.Servers.Empty.Title}"/>
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Margin="0,7,0,0"
                                   MaxWidth="560"
                                   HorizontalAlignment="Left"
                                   Text="{DynamicResource Lang.Servers.Empty.Description}"/>
                    </StackPanel>

                    <ui:Button Grid.Column="2"
                               Style="{StaticResource Button.Pill.Secondary}"
                               VerticalAlignment="Center"
                               Content="{DynamicResource Lang.Servers.Manage}"
                               Click="OnOpenServerManagerClick">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Settings24" FontSize="15"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>

            <StackPanel Margin="0,24,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasServers}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Style="{StaticResource Text.Overline}"
                           Margin="2,0,0,12"
                           Text="{DynamicResource Lang.Servers.All}"/>

                <ListBox x:Name="ServersList"
                         ItemsSource="{Binding Servers}"
                         ItemTemplate="{StaticResource ServerCardTemplate}"
                         SelectionChanged="OnServerListSelectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         Focusable="False">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="IsTabStop" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>

            <Border Style="{StaticResource Surface.Card}"
                    Padding="20"
                    Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="32" Height="32"
                            CornerRadius="{StaticResource Radius.Control}"
                            Background="{DynamicResource Accent.Success.Soft.Brush}">
                        <ui:SymbolIcon Symbol="Info24"
                                       FontSize="14"
                                       Foreground="{DynamicResource Accent.Success.Brush}"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource Text.Caption}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="{DynamicResource Lang.Servers.DragHint}"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
