<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================================================
         Premium Theme — layout metrics, animation tokens and reusable
         micro-animation styles. No magic numbers in views: everything that
         scales, breathes or glows is defined here once and referenced by key.
         ====================================================================== -->

    <!-- Spacing scale -->
    <Thickness x:Key="Space.Page">32,20,32,32</Thickness>
    <Thickness x:Key="Space.Card">20</Thickness>
    <Thickness x:Key="Space.Card.Hero">28</Thickness>
    <Thickness x:Key="Space.Gutter">10</Thickness>
    <Thickness x:Key="Space.SectionTop">0,20,0,0</Thickness>
    <Thickness x:Key="Space.HeaderBottom">2,4,0,24</Thickness>

    <!-- Content sizing -->
    <x:Double x:Key="Width.Content.Max">1080</x:Double>
    <GridLength x:Key="Column.Hero">1.4*</GridLength>
    <GridLength x:Key="Column.Equal">*</GridLength>
    <GridLength x:Key="Column.Auto">Auto</GridLength>

    <!-- Animation durations -->
    <Duration x:Key="Anim.Fast">0:0:0.15</Duration>
    <Duration x:Key="Anim.Normal">0:0:0.25</Duration>
    <Duration x:Key="Anim.Slow">0:0:0.4</Duration>
    <Duration x:Key="Anim.Breathe">0:0:1.6</Duration>
    <Duration x:Key="Anim.Transition">0:0:0.25</Duration>

    <!-- Shared easing -->
    <CubicEase x:Key="Ease.Out" EasingMode="EaseOut"/>
    <SineEase x:Key="Ease.InOut" EasingMode="EaseInOut"/>

    <!-- Glow / lift parameters -->
    <x:Double x:Key="Glow.Card.Blur">18</x:Double>
    <x:Double x:Key="Glow.Card.Opacity">0.28</x:Double>
    <x:Double x:Key="Lift.Card">1.01</x:Double>
    <x:Double x:Key="Breathe.From">0.45</x:Double>
    <x:Double x:Key="Breathe.To">0.95</x:Double>

    <!-- Card hover: soft accent glow + subtle lift -->
    <Style x:Key="Card.Interactive" TargetType="Border" BasedOn="{StaticResource Surface.Card}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource Accent.Traffic.Color}"
                                  BlurRadius="0"
                                  ShadowDepth="0"
                                  Direction="0"
                                  Opacity="0"
                                  RenderingBias="Performance"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).BlurRadius"
                                             To="{StaticResource Glow.Card.Blur}"
                                             Duration="{StaticResource Anim.Normal}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).Opacity"
                                             To="{StaticResource Glow.Card.Opacity}"
                                             Duration="{StaticResource Anim.Normal}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="{StaticResource Lift.Card}"
                                             Duration="{StaticResource Anim.Normal}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="{StaticResource Lift.Card}"
                                             Duration="{StaticResource Anim.Normal}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).BlurRadius"
                                             To="0"
                                             Duration="{StaticResource Anim.Fast}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).Opacity"
                                             To="0"
                                             Duration="{StaticResource Anim.Fast}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1"
                                             Duration="{StaticResource Anim.Fast}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1"
                                             Duration="{StaticResource Anim.Fast}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Status pill: color adapts to the bound ConnectionState value -->
    <Style x:Key="Pill.Status" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Button}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Accent.Danger.Soft.Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Danger.Border.Brush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connecting">
                <Setter Property="Background" Value="{DynamicResource Accent.Traffic.Soft.Brush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent.Traffic.Border.Brush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Connected">
                <Setter Property="Background" Value="{DynamicResource Accent.Success.Soft.Brush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent.Success.Border.Brush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Status dot: fill adapts to the bound ConnectionState value -->
    <Style x:Key="Dot.Status" TargetType="Ellipse">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{DynamicResource Accent.Danger.Brush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connecting">
                <Setter Property="Fill" Value="{DynamicResource Accent.Traffic.Brush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Connected">
                <Setter Property="Fill" Value="{DynamicResource Accent.Success.Brush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Status label: text adapts to the bound ConnectionState value -->
    <Style x:Key="Text.Status" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Text" Value="{DynamicResource Lang.Profile.Status.Disconnected}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connecting">
                <Setter Property="Text" Value="{DynamicResource Lang.Profile.Status.Connecting}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Connected">
                <Setter Property="Text" Value="{DynamicResource Lang.Profile.Status.Connected}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Hero glow ring: breathing pulse while connected -->
    <Style x:Key="Hero.GlowBreathing" TargetType="Ellipse">
        <Setter Property="Opacity" Value="0.8"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connected">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="{StaticResource Breathe.From}"
                                             To="{StaticResource Breathe.To}"
                                             Duration="{StaticResource Anim.Breathe}"
                                             AutoReverse="True"
                                             RepeatBehavior="Forever"
                                             EasingFunction="{StaticResource Ease.InOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Visibility helpers driven by common view-model values -->
    <Style x:Key="Visible.WhenConnecting" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connecting">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Hidden.WhenConnecting" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Visible"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connecting">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Visible.WhenTrafficActive" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Traffic.IsActive}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Hidden.WhenTrafficActive" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Visible"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Traffic.IsActive}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Hidden.WhenHasServers" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Visible"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasServers}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Visible.WhenHasServers" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasServers}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
