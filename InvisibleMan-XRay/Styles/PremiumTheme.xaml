<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ======================================================================
         Premium Theme — layout metrics, animation tokens and reusable
         micro-animation styles. No magic numbers in views: everything that
         scales, breathes or glows is defined here once and referenced by key.
         ====================================================================== -->

    <!-- Spacing scale -->
    <Thickness x:Key="Space.Page">32,20,32,32</Thickness>
    <Thickness x:Key="Space.Card">20</Thickness>
    <Thickness x:Key="Space.Card.Hero">28</Thickness>
    <Thickness x:Key="Neg.Space.Card.Hero">-28</Thickness>
    <Thickness x:Key="Space.Gutter">10</Thickness>
    <Thickness x:Key="Space.SectionTop">0,20,0,0</Thickness>
    <Thickness x:Key="Space.HeaderBottom">2,4,0,24</Thickness>

    <!-- Content sizing -->
    <sys:Double x:Key="Width.Content.Max">1080</sys:Double>
    <GridLength x:Key="Column.Hero">1.4*</GridLength>
    <GridLength x:Key="Column.Equal">*</GridLength>
    <GridLength x:Key="Column.Auto">Auto</GridLength>

    <!-- Animation durations -->
    <Duration x:Key="Anim.Fast">0:0:0.15</Duration>
    <Duration x:Key="Anim.Normal">0:0:0.25</Duration>
    <Duration x:Key="Anim.Slow">0:0:0.4</Duration>
    <Duration x:Key="Anim.Breathe">0:0:1.6</Duration>
    <Duration x:Key="Anim.Transition">0:0:0.25</Duration>

    <!-- Shared easing -->
    <CubicEase x:Key="Ease.Out" EasingMode="EaseOut"/>
    <SineEase x:Key="Ease.InOut" EasingMode="EaseInOut"/>

    <!-- Glow / lift animation values are intentionally inlined in the
         storyboards below: Freezable animation properties (To/From) do not
         accept markup extensions, so they cannot reference resource keys. -->

    <!-- Card hover: soft accent glow + subtle lift -->
    <Style x:Key="Card.Interactive" TargetType="Border" BasedOn="{StaticResource Surface.Card}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource Accent.Traffic.Color}"
                                  BlurRadius="0"
                                  ShadowDepth="0"
                                  Direction="0"
                                  Opacity="0"
                                  RenderingBias="Performance"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                             To="18"
                                             Duration="{StaticResource Anim.Normal}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                             To="0.28"
                                             Duration="{StaticResource Anim.Normal}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1.01"
                                             Duration="{StaticResource Anim.Normal}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.01"
                                             Duration="{StaticResource Anim.Normal}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                             To="0"
                                             Duration="{StaticResource Anim.Fast}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                             To="0"
                                             Duration="{StaticResource Anim.Fast}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1"
                                             Duration="{StaticResource Anim.Fast}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1"
                                             Duration="{StaticResource Anim.Fast}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Status pill: color adapts to the bound ConnectionState value -->
    <Style x:Key="Pill.Status" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Button}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Accent.Danger.Soft.Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Danger.Border.Brush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connecting">
                <Setter Property="Background" Value="{DynamicResource Accent.Traffic.Soft.Brush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent.Traffic.Border.Brush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Connected">
                <Setter Property="Background" Value="{DynamicResource Accent.Success.Soft.Brush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent.Success.Border.Brush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Status dot: fill adapts to the bound ConnectionState value -->
    <Style x:Key="Dot.Status" TargetType="Ellipse">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{DynamicResource Accent.Danger.Brush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connecting">
                <Setter Property="Fill" Value="{DynamicResource Accent.Traffic.Brush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Connected">
                <Setter Property="Fill" Value="{DynamicResource Accent.Success.Brush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Status label: text adapts to the bound ConnectionState value -->
    <Style x:Key="Text.Status" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Text" Value="{DynamicResource Lang.Profile.Status.Disconnected}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connecting">
                <Setter Property="Text" Value="{DynamicResource Lang.Profile.Status.Connecting}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Connected">
                <Setter Property="Text" Value="{DynamicResource Lang.Profile.Status.Connected}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Hero glow ring: breathing pulse while connected -->
    <Style x:Key="Hero.GlowBreathing" TargetType="Ellipse">
        <Setter Property="Opacity" Value="0.8"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connected">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.45"
                                             To="0.95"
                                             Duration="{StaticResource Anim.Breathe}"
                                             AutoReverse="True"
                                             RepeatBehavior="Forever"
                                             EasingFunction="{StaticResource Ease.InOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Visibility helpers driven by common view-model values -->
    <Style x:Key="Visible.WhenConnecting" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connecting">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Hidden.WhenConnecting" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Visible"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connecting">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Visible.WhenTrafficActive" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Traffic.IsActive}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Hidden.WhenTrafficActive" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Visible"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Traffic.IsActive}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Hidden.WhenHasServers" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Visible"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasServers}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Visible.WhenHasServers" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasServers}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Theme segment visibility, driven by SettingsViewModel.ThemeMode -->
    <Style x:Key="Visible.WhenThemeDark" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ThemeMode}" Value="Dark">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Visible.WhenThemeLight" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ThemeMode}" Value="Light">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Visible.WhenThemeSystem" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ThemeMode}" Value="System">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Hero connect button: state-driven content + hover glow/lift, all on tokens -->
    <Style x:Key="Button.Hero.Stateful" TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource Button.Hero.Connect}">
        <Setter Property="Command" Value="{Binding ConnectCommand}"/>
        <Setter Property="Content" Value="{DynamicResource Lang.Profile.Connect}"/>
        <Setter Property="Appearance" Value="Primary"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Icon">
            <Setter.Value>
                <ui:SymbolIcon Symbol="Power24" FontSize="16"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource Accent.Success.Color}"
                                  BlurRadius="0"
                                  ShadowDepth="0"
                                  Direction="0"
                                  Opacity="0"
                                  RenderingBias="Performance"/>
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connecting">
                <Setter Property="Command" Value="{Binding CancelCommand}"/>
                <Setter Property="Content" Value="{DynamicResource Lang.Cancel}"/>
                <Setter Property="Appearance" Value="Secondary"/>
                <Setter Property="Icon">
                    <Setter.Value>
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Connected">
                <Setter Property="Command" Value="{Binding DisconnectCommand}"/>
                <Setter Property="Content" Value="{DynamicResource Lang.Profile.Disconnect}"/>
                <Setter Property="Appearance" Value="Danger"/>
                <Setter Property="Icon">
                    <Setter.Value>
                        <ui:SymbolIcon Symbol="Power24" FontSize="16"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding State}" Value="Disconnected"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                             To="26"
                                             Duration="{StaticResource Anim.Normal}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                             To="0.55"
                                             Duration="{StaticResource Anim.Normal}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1.03"
                                             Duration="{StaticResource Anim.Normal}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.03"
                                             Duration="{StaticResource Anim.Normal}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                             To="0"
                                             Duration="{StaticResource Anim.Fast}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                             To="0"
                                             Duration="{StaticResource Anim.Fast}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1"
                                             Duration="{StaticResource Anim.Fast}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1"
                                             Duration="{StaticResource Anim.Fast}"
                                             EasingFunction="{StaticResource Ease.Out}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
