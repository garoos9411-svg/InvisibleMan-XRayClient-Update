<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Accent palette: Emerald (connection/success) + Sapphire-cyan (traffic) -->
    <Color x:Key="Accent.Success.Color">#10B981</Color>
    <Color x:Key="Accent.Traffic.Color">#38BDF8</Color>
    <Color x:Key="Accent.Danger.Color">#F43F5E</Color>

    <SolidColorBrush x:Key="Accent.Success.Brush" Color="{StaticResource Accent.Success.Color}"/>
    <SolidColorBrush x:Key="Accent.Success.Soft.Brush" Color="#2610B981"/>
    <SolidColorBrush x:Key="Accent.Success.Border.Brush" Color="#5910B981"/>

    <SolidColorBrush x:Key="Accent.Traffic.Brush" Color="{StaticResource Accent.Traffic.Color}"/>
    <SolidColorBrush x:Key="Accent.Traffic.Soft.Brush" Color="#1F38BDF8"/>
    <SolidColorBrush x:Key="Accent.Traffic.Border.Brush" Color="#4D38BDF8"/>

    <SolidColorBrush x:Key="Accent.Danger.Brush" Color="{StaticResource Accent.Danger.Color}"/>
    <SolidColorBrush x:Key="Accent.Danger.Soft.Brush" Color="#26F43F5E"/>
    <SolidColorBrush x:Key="Accent.Danger.Border.Brush" Color="#59F43F5E"/>

    <!-- Hero button -->
    <Color x:Key="Accent.Success.Deep.Color">#059669</Color>
    <Color x:Key="Accent.Success.Bright.Color">#34D399</Color>
    <Color x:Key="Accent.Success.Pressed.Color">#047857</Color>
    <Color x:Key="Text.On.Accent.Color">#04211A</Color>

    <SolidColorBrush x:Key="Text.On.Accent.Brush" Color="{StaticResource Text.On.Accent.Color}"/>

    <LinearGradientBrush x:Key="Accent.Success.Gradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Accent.Success.Color}" Offset="0"/>
        <GradientStop Color="{StaticResource Accent.Success.Deep.Color}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Accent.Success.Gradient.Bright" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Accent.Success.Bright.Color}" Offset="0"/>
        <GradientStop Color="{StaticResource Accent.Success.Color}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Accent.Success.Gradient.Pressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Accent.Success.Deep.Color}" Offset="0"/>
        <GradientStop Color="{StaticResource Accent.Success.Pressed.Color}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="Accent.Hero.Ring" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Accent.Success.Color}" Offset="0"/>
        <GradientStop Color="{StaticResource Accent.Traffic.Color}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Accent.Hero.Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A10B981" Offset="0"/>
        <GradientStop Color="#0F38BDF8" Offset="0.55"/>
        <GradientStop Color="#0038BDF8" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="Accent.Hero.Glow" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#3310B981" Offset="0"/>
        <GradientStop Color="#1438BDF8" Offset="0.6"/>
        <GradientStop Color="#0038BDF8" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="Accent.Chart.Area" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3838BDF8" Offset="0"/>
        <GradientStop Color="#0038BDF8" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Accent.Chart.Line" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Accent.Success.Color}" Offset="0"/>
        <GradientStop Color="{StaticResource Accent.Traffic.Color}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Texture -->
    <ImageBrush x:Key="Texture.Noise"
                ImageSource="pack://application:,,,/Assets/Noise.png"
                Stretch="None"
                TileMode="Tile"
                Viewport="0,0,160,160"
                ViewportUnits="Absolute"/>

    <!-- Elevation shadow values are inlined in Surface.Card below; animation
         glow/lift values live in PremiumTheme storyboards (Freezable To/From
         attributes do not accept markup extensions). -->

    <!-- Radii -->
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Control">10</CornerRadius>
    <CornerRadius x:Key="Radius.Button">25</CornerRadius>

    <!-- Surfaces -->
    <Style x:Key="Surface.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="24"
                                  ShadowDepth="2"
                                  Direction="270"
                                  Opacity="0.32"
                                  RenderingBias="Performance"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Surface.Pill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Button}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Surface.IconTile" TargetType="Border">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Typography -->
    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Text.PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Text.CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Text.Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
    </Style>

    <Style x:Key="Text.Metric" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="Button.Icon.Ghost" TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
    </Style>

    <Style x:Key="Button.Pill.Primary" TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Primary"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Button}"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Padding" Value="28,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="Button.Pill.Secondary" TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Secondary"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Button}"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="Button.Hero.Connect" TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Height" Value="46"/>
        <Setter Property="Padding" Value="30,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Button}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="Appearance" Value="Primary">
                <Setter Property="Background" Value="{DynamicResource Accent.Success.Gradient}"/>
                <Setter Property="MouseOverBackground" Value="{DynamicResource Accent.Success.Gradient.Bright}"/>
                <Setter Property="PressedBackground" Value="{DynamicResource Accent.Success.Gradient.Pressed}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.On.Accent.Brush}"/>
                <Setter Property="PressedForeground" Value="{DynamicResource Text.On.Accent.Brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Card.Action" TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Secondary"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Theme selector: premium segmented radio card (Settings page) -->
    <Style x:Key="Radio.ThemeCard" TargetType="{x:Type RadioButton}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Chrome"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="12,9"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource Accent.Traffic.Soft.Brush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource Accent.Traffic.Soft.Brush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Accent.Traffic.Border.Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
